# NEO-Guard Environment Variables
# Copy this file to .env and fill in the values.

# ── Required ─────────────────────────────────────────────────────
# NASA API key for data access (get one at https://api.nasa.gov/)
NASA_API_KEY=

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/neoguard

# ── Optional ─────────────────────────────────────────────────────
# Environment flag: development | production
MODEL_ENV=development

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173
