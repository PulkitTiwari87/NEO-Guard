# NEO-Guard environment variables. Copy to .env (never commit .env) and fill in the values.
# NASA_API_KEY is intentionally absent: the JPL SSD/CNEOS APIs used here (SBDB Query, CAD)
# require no key. See docs/DATA_SOURCE.md.

# ── Required ─────────────────────────────────────────────────────
# PostgreSQL connection string used by the API, Alembic and `python -m app.cli`.
DATABASE_URL=postgresql://neoguard:CHANGE_ME@127.0.0.1:5432/neoguard

# Password for the docker-compose `db` service (must match the password in DATABASE_URL).
POSTGRES_PASSWORD=CHANGE_ME

# Host port for the docker-compose `db` service. If you change it, use the same port in DATABASE_URL.
# POSTGRES_HOST_PORT=5432

# ── Optional ─────────────────────────────────────────────────────
# development | production | test. In production CORS_ORIGINS may not contain '*'.
MODEL_ENV=development

# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:5173

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Max requests per minute per client (0 disables). /api/health is exempt.
RATE_LIMIT_PER_MINUTE=120

# Uncomment to override defaults:
# MODEL_DIR=ml/artifacts            # directory holding trained model artifacts
# ACTIVE_MODEL_VERSION=random_forest-v1   # pin the served model (default: best status, then validation PR-AUC)
# NEOGUARD_DATA_DIR=data            # data pipeline root (raw/interim/processed)
